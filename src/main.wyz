// Aegis Bot Main Entry Point (Wyzer)
import bundle::lib::wyzer_discord::api;
import config;

role @DiscordGateway;
role @BotLogic;

// The main choreographic loop
fn run_bot(token: str) @ BotLogic {
    std::io::println("Starting Aegis on Wyzer...");
    
    // Connect to the gateway (mocked)
    let connected: bool = api::connect(token);
    
    if connected {
        std::io::println("Connected to Discord Gateway successfully.");
        
        // Main event loop
        var running: bool = true;
        while running {
            // Receive an event from the gateway
            let event: api::GatewayEvent = api::receive_event();
            
            match (event) {
                MessageCreate(msg) => {
                    std::io::println(f"Received message from {msg.author.username}: {msg.content}");
                    // Here we would route to command handler
                },
                InteractionCreate(interaction) => {
                    std::io::println("Received interaction");
                },
                Ready => {
                    std::io::println("Bot is Ready!");
                },
                None => {
                    // For the sake of the mock, we can exit the loop if None is returned
                    running = false;
                }
            };
        }
    } else {
        std::io::eprintln("Failed to connect to Discord.");
    }
}

fn main() {
    let conf = config::load_config();
    run_bot(conf.discord_token);
}
