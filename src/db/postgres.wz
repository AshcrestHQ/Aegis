// Aegis PostgreSQL Database Manager (Wyzer)
import bundle::lib::wyzer_postgres::client;
import config;

var pg_connection_active: bool = false;

fn init_db() -> bool {
    let conf = config::load_config();
    let conn_str = f"host={conf.db_host} user={conf.db_user} password={conf.db_pass}";
    
    // Connect using the newly built wyzer_postgres library
    pg_connection_active = client::connect(conn_str);
    
    if pg_connection_active {
        std::io::println("Connected to PostgreSQL successfully.");
        return true;
    } else {
        std::io::eprintln("Failed to connect to PostgreSQL.");
        return false;
    }
}

fn execute_query(query: str) -> bool {
    if !pg_connection_active {
        return false;
    }
    return client::query(query);
}
